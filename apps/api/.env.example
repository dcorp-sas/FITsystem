# ============================================================================
# FIT System · API — variables de entorno
# Copiá este archivo a .env y completá los valores. En producción (Render) se
# configuran en el panel del servicio; este archivo sirve de referencia y para
# correr local, en Docker o en cualquier otro hosting.
# ----------------------------------------------------------------------------

# --- Base de datos -----------------------------------------------------------
# SQLite local/escritorio o PostgreSQL en la nube (postgres://usuario:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# ---------- Seguridad ----------
# Secreto para firmar los tokens JWT. En PRODUCCIÓN es obligatorio y debe tener
# al menos 32 caracteres (no usar los valores por defecto del repo). En Render se
# genera solo (generateValue:true); en el escritorio se genera por instalación.
# Ejemplo seguro: openssl rand -hex 24
JWT_SECRET=""

# Clave para cifrar secretos en reposo (credenciales de MercadoPago, ARCA, SMTP).
# Si queda vacía se deriva del JWT_SECRET; definirla propia permite rotar el JWT
# sin perder los secretos guardados. Ej: openssl rand -hex 32
SETTINGS_ENC_KEY=""

API_PORT=3001
# Por defecto solo loopback (escritorio). En la nube usar 0.0.0.0.
API_HOST=0.0.0.0

# Orígenes permitidos por CORS, separados por coma (panel web + PWA de socios).
# Ej: https://fitsystem-web.onrender.com,https://fitsystem-socios.onrender.com
WEB_ORIGIN=http://localhost:3000

# URL pública de esta API (para webhooks de MercadoPago). Ej: https://fitsystem-api.onrender.com
PUBLIC_URL=""

# URL pública de la app de socios (PWA), usada como retorno de MercadoPago.
SOCIOS_URL=""

# ---------------------------------------------------------------------------
# Licenciamiento
# ---------------------------------------------------------------------------
# URL del Licensador (sistema de licencias del proveedor). Si está definida, la
# activación se hace en línea y se guarda un certificado firmado.
LICENSE_SERVER=""
LICENSE_TRIAL_DAYS=7

# Alternativa simple por HMAC (compartida con el Licensador). Se usa solo si NO
# hay clave Ed25519.
LICENSE_SECRET=""

# Clave PÚBLICA Ed25519 del proveedor (base64 del JWK), embebida en el producto
# para verificar claves/certificados. DEBE corresponder a la clave privada del
# Licensador (LICENSE_PRIVATE_KEY). Si se omite, se usa la embebida por defecto.
# Podés obtenerla con: node apps/licensador/public-key.js  (o desde el panel).
LICENSE_PUBLIC_KEY=""

# Clave PRIVADA Ed25519 (solo para emitir desde este proceso). NO va en el
# producto distribuido; vive en el Licensador. Opcional.
LICENSE_PRIVATE_KEY=""

LICENSE_CONTACT="contacto.fitsystem@gmail.com"
LICENSE_SITE="https://fitsystem.onrender.com"

# ID de instalación (solo producto de escritorio).
LICENSE_INSTALLATION_ID=""

# Token compartido con el Licensador para respaldar/restaurar su estado en
# Postgres (su disco es efímero en el plan free). Debe coincidir con BACKUP_TOKEN
# del Licensador. Si está vacío, el respaldo remoto queda deshabilitado.
PROVIDER_BACKUP_TOKEN=""

# Carpeta donde se guarda la sesión de WhatsApp vinculada por QR (Baileys). Debe
# ser persistente: si se borra hay que volver a escanear el QR. Si se deja vacía,
# por defecto se usa una carpeta "whatsapp" junto a la base de datos.
WHATSAPP_AUTH_DIR=""
