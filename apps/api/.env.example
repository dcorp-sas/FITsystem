# Base de datos local (SQLite) o PostgreSQL en la nube (DATABASE_URL=postgres://...)
DATABASE_URL="file:./dev.db"

# Secreto para firmar los tokens JWT. En PRODUCCIÓN es obligatorio y debe tener al
# menos 32 caracteres (no usar los valores por defecto del repo). En Render se
# genera solo (generateValue:true); en el escritorio se genera por instalación.
# Ejemplo seguro: openssl rand -hex 24
JWT_SECRET=""

API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# URL pública de esta API (para webhooks de MercadoPago). Ej: https://fitsystem-api.onrender.com
PUBLIC_URL=""

# URL publica de la app de socios (PWA), usada como retorno de MercadoPago.
SOCIOS_URL=""