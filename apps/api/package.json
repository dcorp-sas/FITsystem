{
  "name": "@fitsystem/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "test": "tsx --test src/lib/member-qr.test.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:generate:pg": "node scripts/pg-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:pg": "node scripts/pg-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma --skip-generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fitsystem/license": "workspace:*",
    "@fitsystem/types": "workspace:*",
    "@fitsystem/utils": "workspace:*",
    "@fitsystem/validators": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@sinclair/typebox": "^0.33.9",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}