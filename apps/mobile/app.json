{
  "expo": {
    "name": "FIT system™ Socios",
    "slug": "fitsystem-socios",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fitsystem",
    "splash": {
      "backgroundColor": "#0b1120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fitsystem.socios",
      "infoPlist": {
        "NSCameraUsageDescription": "FIT system™ usa la cámara para escanear el QR de ingreso al gimnasio."
      }
    },
    "android": {
      "package": "app.fitsystem.socios",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#0b1120",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "FIT system™ — App del socio",
      "shortName": "FIT Socios",
      "themeColor": "#0b1120",
      "backgroundColor": "#0b1120"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permití que FIT system™ use la cámara para escanear el QR de ingreso al gimnasio."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:3001"
    }
  }
}
