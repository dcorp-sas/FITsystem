{
  "name": "fitsystem",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @fitsystem/api prisma generate",
    "db:push": "pnpm --filter @fitsystem/api prisma db push",
    "db:migrate": "pnpm --filter @fitsystem/api prisma migrate dev",
    "db:seed": "pnpm --filter @fitsystem/api prisma db seed",
    "db:export": "node scripts/db-export.mjs",
    "db:import": "node scripts/db-import.mjs"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
