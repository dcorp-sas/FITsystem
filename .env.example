# Variables para `docker compose` (copiar a .env y completar).
# Ver también apps/api/.env.example para el detalle de cada una.

# --- Base de datos (contenedor db) ---
POSTGRES_PASSWORD="cambiame"

# --- API -------------------------------------------------------------------
# openssl rand -hex 24
JWT_SECRET=""
# openssl rand -hex 32 (si queda vacío se deriva del JWT_SECRET)
SETTINGS_ENC_KEY=""
PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# URL pública de la app de socios (PWA). Ej: http://localhost:4000
SOCIOS_URL=""

# ---------------------------------------------------------------------------
# Licenciamiento
# ---------------------------------------------------------------------------
# El licensador corre en http://licensador:3000 dentro de la red de compose.
LICENSE_SERVER=http://licensador:3000
LICENSE_TRIAL_DAYS=7

# Firma del licensador. Recomendado: un par Ed25519.
#   - LICENSE_PRIVATE_KEY: JWK privado (base64). Se define solo acá (licensador).
#   - LICENSE_PUBLIC_KEY:  JWK público (base64). Debe corresponder; lo usa la API.
# Alternativa simple (menos segura): un LICENSE_SECRET compartido (HMAC).
LICENSE_PRIVATE_KEY=""
LICENSE_PUBLIC_KEY=""
LICENSE_SECRET=""

# Token compartido para respaldar/restaurar el estado del licensador en Postgres.
PROVIDER_BACKUP_TOKEN=""
# Base de la API a la que el licensador respalda su estado. Debe terminar en /api
# (ahi viven las rutas /api/provider/backup) y su token es PROVIDER_BACKUP_TOKEN.
BACKUP_URL="http://api:3001/api"

# Panel del licensador
ADMIN_USER=admin
ADMIN_PASS=""
