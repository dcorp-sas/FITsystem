# Variables para `docker compose -f docker-compose.prod.yml` (copiar a .env).
# Guia paso a paso: docs/VPS.md
#
#   cp .env.vps.example .env
#
# ATENCION: reemplaza TODOS los valores vacios. Las variables marcadas con
# `:?` en docker-compose.prod.yml cortan el arranque si quedan vacias.

# --- Dominio ---------------------------------------------------------------
# El dominio raiz (sin https://). Los subdominios api/socios/licensador se
# derivan de este valor en el Caddyfile.
SITE_DOMAIN="fitsystem.com.ar"
# Correo para los avisos de vencimiento de Let's Encrypt.
ACME_EMAIL="contacto.fitsystem@gmail.com"

# --- Base de datos ---------------------------------------------------------
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=""

# --- API -------------------------------------------------------------------
# Generar con: openssl rand -hex 24
JWT_SECRET=""
# Generar con: openssl rand -hex 32 (si queda vacio se deriva del JWT_SECRET)
SETTINGS_ENC_KEY=""

# URLs publicas. Se usan en webhooks de MercadoPago, enlaces de onboarding y
# en los origenes CORS. Deben coincidir con los subdominios del DNS.
PUBLIC_URL="https://api.fitsystem.com.ar"
SOCIOS_URL="https://socios.fitsystem.com.ar"
WEB_ORIGIN="https://fitsystem.com.ar,https://www.fitsystem.com.ar,https://socios.fitsystem.com.ar"

# --- URLs incrustadas en el build (NEXT_PUBLIC_* / EXPO_PUBLIC_*) ----------
# Se hornean en los bundles: si cambian hay que RECONSTRUIR las imagenes.
NEXT_PUBLIC_API_URL="https://api.fitsystem.com.ar"
NEXT_PUBLIC_SOCIOS_URL="https://socios.fitsystem.com.ar"
EXPO_PUBLIC_API_URL="https://api.fitsystem.com.ar"

# ---------------------------------------------------------------------------
# Licenciamiento
# ---------------------------------------------------------------------------
# El licensador corre en http://licensador:3000 dentro de la red de compose.
# BACKUP_URL debe incluir /api (ahi viven las rutas /api/provider/backup).
LICENSE_SERVER="http://licensador:3000"
BACKUP_URL="http://api:3001/api"
LICENSE_TRIAL_DAYS=7

# Firma del licensador. Recomendado: un par Ed25519.
#   - LICENSE_PRIVATE_KEY: JWK privado (base64). Se define solo aca (licensador).
#   - LICENSE_PUBLIC_KEY:  JWK publico (base64). Debe corresponder; lo usa la API.
# Alternativa simple (menos segura): un LICENSE_SECRET compartido (HMAC).
LICENSE_PRIVATE_KEY=""
LICENSE_PUBLIC_KEY=""
LICENSE_SECRET=""

# Token compartido para respaldar/restaurar el estado del licensador en Postgres.
# Generar con: openssl rand -hex 24
PROVIDER_BACKUP_TOKEN=""

# Panel del licensador
ADMIN_USER=admin
# Generar con: openssl rand -base64 18
ADMIN_PASS=""

# ---------------------------------------------------------------------------
# Cuenta del PROVEEDOR (sitio / venta de planes)
# ---------------------------------------------------------------------------
# Credenciales de admin del Licensador que usa la API para emitir la clave
# cuando se aprueba una compra. Deben coincidir con ADMIN_USER/ADMIN_PASS.
LICENSOR_ADMIN_USER=admin
LICENSOR_ADMIN_PASS=""

# MercadoPago de la cuenta del proveedor (pago embebido en el sitio).
PLATFORM_MP_ACCESS_TOKEN=""
PLATFORM_MP_PUBLIC_KEY=""
PLATFORM_MP_WEBHOOK_SECRET=""

# Email del sitio (formulario de contacto y alta de compra). Brevo tiene
# prioridad sobre SMTP en hosts que bloquean los puertos SMTP.
PLATFORM_CONTACT_TO="contacto.fitsystem@gmail.com"
PLATFORM_SMTP_HOST=""
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=""
PLATFORM_SMTP_USER=""
PLATFORM_SMTP_PASS=""
PLATFORM_SMTP_FROM="FIT system™ <contacto.fitsystem@gmail.com>"
PLATFORM_BREVO_API_KEY=""

# Notificaciones push de la app de socios (Expo/Web Push).
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto.fitsystem@gmail.com"
